# VibeResearch 后端可选配置。
# 本地自托管：全部留空即可（开箱开放）。公网部署：务必设置下面两项。
# 用法：复制为 .env，或直接 export 这些环境变量后再起服务。

# ── 安全（公网部署必设） ─────────────────────────────────────────────
# CORS 白名单，逗号分隔。默认 "*"（放开，适合本地）。公网收紧成你的前端域名：
#   VR_ALLOW_ORIGINS=https://your-frontend-host
VR_ALLOW_ORIGINS=*

# 鉴权 key。一旦设置，所有 /api/*（除 /api/health）都需带 Authorization: Bearer <key>。
# 本地留空=开放；公网部署务必设一个强随机值（否则别人能读你的持仓、调你的后端）：
#   VR_API_KEY=$(openssl rand -hex 32)
VR_API_KEY=

# ── 数据源（可选） ───────────────────────────────────────────────────
# 行情/研报/公告/资金面等零 key 即用；仅 iwencai 语义搜索研报需要 key：
# IWENCAI_API_KEY=
# IWENCAI_BASE_URL=https://openapi.iwencai.com

# 网络：默认不用管。东财等国内数据源**默认直连**（部分网络环境的系统设置会让
# 国内财经站连不上，如 push2.eastmoney.com，故直连优先、失败自动降级）。
# 仅当你的机器「只能经系统网络设置才能出网」时，才设为 1 跳过直连探测：
# VR_DATA_PROXY=1

# ── FT-Research AI（V1：GLM 5.3 Flash，密钥只放后端） ───────────────
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_API_KEY=

# ── 主人 / 游客会话 ──────────────────────────────────────────────────
# 生成哈希：python scripts/owner_password.py（只输出哈希，不写文件）
FT_OWNER_PASSWORD_HASH=
# 公开演示启用逐路由鉴权、游客内存令牌与服务端额度；本机开发可留 false。
FT_PUBLIC_DEMO=false
FT_AUTH_SECURE_COOKIE=false
FT_ALLOWED_ORIGINS=http://localhost:5173
# SQLite 与会话数据目录，生产请挂载持久卷（例如 /data）。
VR_DATA_DIR=
FT_GUEST_DAILY_CALLS=5
FT_IP_DAILY_CALLS=30
FT_SITE_DAILY_CALLS=100
