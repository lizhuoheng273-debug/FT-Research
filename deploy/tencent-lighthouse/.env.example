DOMAIN=research.vincentli-website.com

GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_API_KEY='replace-me'

FT_OWNER_PASSWORD_HASH='replace-me'
FT_PUBLIC_DEMO=true
FT_AUTH_SECURE_COOKIE=true
FT_ALLOWED_ORIGINS=https://research.vincentli-website.com
VR_ALLOW_ORIGINS=https://research.vincentli-website.com

# Public visitors authenticate through administrator/visitor sessions. A shared
# browser API key would break that flow and must stay empty in this deployment.
VR_API_KEY=
VR_DATA_DIR=/data

FT_GUEST_DAILY_CALLS=5
FT_IP_DAILY_CALLS=30
FT_SITE_DAILY_CALLS=100
FT_GUEST_SESSION_IP_PER_HOUR=20
FT_GUEST_SESSION_SITE_PER_HOUR=200
